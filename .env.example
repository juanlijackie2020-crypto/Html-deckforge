# Copy to .env.local and fill in real values (.env.local is git-ignored).
#
# Server-side only (read by the llmProxyPlugin in vite.config.ts): the dev
# proxy injects the API key, so it never appears in client code or bundles.
LLM_BASE_URL=https://genai-nexus-cn.int.mercedes-benz.com.cn/oneapi/alibaba-bailian/apps/anthropic
LLM_API_KEY=your-api-key-here
# Corporate egress proxy (leave empty if none)
LLM_PROXY=

# Client-visible (VITE_ prefix): model name only, non-secret
VITE_LLM_MODEL=qwen3.7-max
