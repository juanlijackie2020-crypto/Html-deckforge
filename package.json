{
  "name": "deckforge",
  "version": "0.1.0",
  "description": "AI-Powered Presentation Studio for Mercedes-Benz branded HTML slide decks",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "set NODE_TLS_REJECT_UNAUTHORIZED=0 && vite",
    "build": "tsc && vite build && electron-builder",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "cheerio": "^1.0.0-rc.12",
    "jszip": "^3.10.1",
    "lucide-react": "^0.400.0",
    "mammoth": "^1.12.0",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^9.0.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/jszip": "^3.4.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^31.2.0",
    "electron-builder": "^24.13.3",
    "eslint": "^9.6.0",
    "https-proxy-agent": "^9.1.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vite-plugin-electron": "^0.28.7",
    "vitest": "^3.2.7",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.deckforge.app",
    "productName": "DeckForge",
    "win": {
      "target": "nsis"
    }
  }
}
